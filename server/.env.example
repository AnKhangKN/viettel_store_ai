# EMAIL DELIVERY
# smtp: gửi qua SMTP (chỉ hoạt động local hoặc Render paid — Render free chặn cổng 25/465/587)
# resend: gửi qua Resend API HTTPS (khuyến nghị cho Render free tier)
# log: không gửi mail, chỉ ghi OTP/hóa đơn ra log để test
EMAIL_DELIVERY_MODE=smtp
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT=10
# Resend (https://resend.com) — dùng khi deploy Render free tier
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TEST_SEND_OTP_TO_OWNER=false
